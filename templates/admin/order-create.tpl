{if $flash}<div class="alert alert-warning">{$flash|escape}</div>{/if}
<div class="admin-panel p-4 mb-3"><h2 class="h5">1. Müşteri</h2>
<div class="position-relative"><input id="customerSearch" class="form-control" autocomplete="off" placeholder="İsim, soyisim, telefon veya e-posta ile ara" value="{$selectedCustomer.user_full_name|default:''|escape}"><div id="customerResults" class="list-group position-absolute w-100 shadow" style="z-index:10"></div></div>
{if $selectedCustomer}<div class="alert alert-success mt-3 mb-0">{$selectedCustomer.user_full_name|escape} — {$selectedCustomer.email|escape} — {$selectedCustomer.phone|escape}</div>{/if}
<div id="customerSearchStatus" class="small text-muted mt-2" aria-live="polite"></div>
<div id="newCustomerBox" class="mt-3" hidden><p class="small text-muted mb-2">Bu e-posta veya arama için müşteri bulunamadı. Yeni müşteri bilgilerini girin.</p><form method="post" class="row g-2"><input type="hidden" name="createCustomer" value="1"><input type="hidden" name="token" value="{$adminToken|escape}"><div class="col"><input name="customer_name" class="form-control" placeholder="Ad soyad" required></div><div class="col"><input name="customer_phone" class="form-control" placeholder="Telefon" required></div><div class="col"><input id="newCustomerEmail" name="customer_email" type="email" class="form-control" placeholder="E-posta" required></div><div class="col-auto"><button class="btn btn-primary">Yeni müşteri ekle</button></div></form></div></div>
{if $selectedCustomer}<form method="post" class="admin-panel p-4"><input type="hidden" name="saveAdminOrder" value="1"><input type="hidden" name="token" value="{$adminToken|escape}"><input type="hidden" name="id_user" value="{$selectedCustomer.id_user}"><h2 class="h5">2. Ürünler</h2><div class="row g-2 mb-2"><div class="col position-relative"><input id="productSearch" class="form-control" autocomplete="off" placeholder="Ürün ara, seçince sepete eklenir"><div id="productResults" class="list-group position-absolute w-100 shadow" style="z-index:10"></div></div></div><div id="orderProducts"></div>
<h2 class="h5 mt-4">3. Adres ve alıcı</h2>{if $addresses}<select name="id_address" class="form-select mb-2"><option value="0">Yeni adres gir</option>{foreach $addresses as $address}<option value="{$address.id_address}">{$address.label|escape} — {$address.city|escape} / {$address.district|escape}</option>{/foreach}</select>{else}<input type="hidden" name="id_address" value="0">{/if}<div class="row g-2 mb-2"><div class="col-md-6"><input name="recipient_name" class="form-control" value="{$selectedCustomer.user_full_name|escape}" placeholder="Alıcı adı soyadı" required></div><div class="col-md-6"><input name="recipient_phone" class="form-control" value="{$selectedCustomer.phone|escape}" placeholder="Alıcı telefonu" required></div></div><div class="row g-2"><div class="col-md-4"><input name="city" class="form-control" placeholder="İl"></div><div class="col-md-4"><input name="district" class="form-control" placeholder="İlçe"></div><div class="col-md-4"><input name="address_text" class="form-control" placeholder="Açık adres"></div></div><label class="form-check mt-2"><input type="checkbox" name="save_address" value="1" class="form-check-input"> Adresi müşterinin hesabına kaydet</label>
<h2 class="h5 mt-4">4–5. Kargo ve ödeme</h2><div class="row g-2"><div class="col-md-6"><select name="id_cargo" class="form-select"><option value="0">Kargo seçin</option>{foreach $cargoOptions as $cargo}<option value="{$cargo.id_cargo}"{if $defaultCargoId == $cargo.id_cargo} selected{/if}>{$cargo.name|escape}</option>{/foreach}</select></div><div class="col-md-6"><select name="payment_method" class="form-select">{foreach $paymentMethods as $method}<option value="{$method.id|escape}">{$method.label|escape}</option>{/foreach}</select></div></div>
<div class="row g-2 mt-3"><div class="col-md-4"><input name="coupon_code" class="form-control" placeholder="İndirim kodu"></div><div class="col-md-4"><select name="manual_discount_type" class="form-select"><option value="fixed">Ek indirim — TL</option><option value="percent">Ek indirim — %</option></select></div><div class="col-md-4"><input name="manual_discount" type="number" min="0" step="0.01" class="form-control" placeholder="İndirim tutarı / oranı"></div></div>
<div class="border rounded p-3 mt-4"><h3 class="h6">Sipariş toplamı</h3><div id="orderTotals" class="small text-muted">Ürün seçtikçe hesaplanacak.</div></div><button class="btn btn-success mt-4">Siparişi kaydet</button></form>{/if}
<div id="orderCreateConfig" data-url="{$orderCreateUrl|escape}"></div>
<script>
{literal}
(function(){var base=document.getElementById('orderCreateConfig').getAttribute('data-url'),sep=base.indexOf('?')>=0?'&':'?';function debounce(fn){var t;return function(){var a=arguments;clearTimeout(t);t=setTimeout(function(){fn.apply(null,a)},220)}}function render(items,box,make){box.innerHTML='';items.forEach(function(x){var b=document.createElement('button');b.type='button';b.className='list-group-item list-group-item-action';b.textContent=make(x);b.onclick=function(){box.dispatchEvent(new CustomEvent('choose',{detail:x}))};box.appendChild(b)})}var cs=document.getElementById('customerSearch'),cr=document.getElementById('customerResults'),newBox=document.getElementById('newCustomerBox'),emailField=document.getElementById('newCustomerEmail'),status=document.getElementById('customerSearchStatus');if(cs){cs.addEventListener('input',debounce(function(){var q=cs.value.trim();newBox.hidden=true;status.textContent=q?'Müşteri aranıyor…':'';if(q.length<2){cr.innerHTML='';status.textContent='En az 2 karakter yazın.';return}fetch(base+sep+'lookup=customers&q='+encodeURIComponent(q)).then(function(r){return r.json()}).then(function(a){render(a,cr,function(x){return x.user_full_name+' — '+x.email+' — '+x.phone});var isEmail=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(q);emailField.value=isEmail?q:'';newBox.hidden=a.length>0;status.textContent=a.length?(a.length+' müşteri bulundu.'):'Eşleşme bulunamadı.'})}));cr.addEventListener('choose',function(e){location.href=base+sep+'customer_id='+e.detail.id_user})}var ps=document.getElementById('productSearch'),pr=document.getElementById('productResults'),list=document.getElementById('orderProducts');if(ps){ps.addEventListener('input',debounce(function(){fetch(base+sep+'lookup=products&q='+encodeURIComponent(ps.value)).then(function(r){return r.json()}).then(function(a){render(a,pr,function(x){return x.product_name+' — '+x.price+' ₺'})})}));pr.addEventListener('choose',function(e){var x=e.detail,row=document.createElement('div'),step=parseFloat(x.sale_qty_step)||1,min=parseFloat(x.sale_qty_min)||step;row.className='row g-2 mb-2 align-items-center';row.innerHTML='<input type="hidden" name="product_id[]"><div class="col-md-7"></div><div class="col-md-3"><input name="qty[]" type="number" class="form-control"></div><div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100">Kaldır</button></div>';var qty=row.querySelector('[name="qty[]"]');qty.min=min;qty.step=step;qty.value=min;row.querySelector('[name="product_id[]"]').value=x.id_product;row.querySelector('.col-md-7').textContent=x.product_name+' — '+x.price+' ₺';row.querySelector('button').onclick=function(){row.remove()};list.appendChild(row);ps.value='';pr.innerHTML=''})}})();
{/literal}
</script>
{if $selectedCustomer}
<script>
{literal}
(function(){var h=document.querySelector('input[name="saveAdminOrder"]'),box=document.getElementById('orderTotals');if(!h||!box)return;var form=h.closest('form'),base=document.getElementById('orderCreateConfig').getAttribute('data-url'),sep=base.indexOf('?')>=0?'&':'?',timer;function update(){clearTimeout(timer);timer=setTimeout(function(){var fd=new FormData(form),ids=fd.getAll('product_id[]'),qty=fd.getAll('qty[]'),items=[];ids.forEach(function(id,i){if(id)items.push({id:id,qty:qty[i]||1})});var p=new URLSearchParams({lookup:'totals',items:JSON.stringify(items),payment:fd.get('payment_method')||'',cargo:fd.get('id_cargo')||0,coupon:fd.get('coupon_code')||'',manual:fd.get('manual_discount')||0,manual_type:fd.get('manual_discount_type')||'fixed'});fetch(base+sep+p.toString()).then(function(r){return r.json()}).then(function(x){if(x.error){box.textContent=x.error;return}var rows=[['Ürünler',x.subtotal]];if(x.promotion!=='0,00 ₺')rows.push(['Kampanya indirimi','-'+x.promotion]);if(x.coupon!=='0,00 ₺')rows.push(['Kupon indirimi','-'+x.coupon]);if(x.payment!=='0,00 ₺')rows.push([x.payment_label||'Ödeme indirimi','-'+x.payment]);rows.push(['Kargo',x.shipping]);if(x.manual!=='0,00 ₺')rows.push(['Ek indirim','-'+x.manual]);box.innerHTML=rows.map(function(r){var d=document.createElement('div');d.className='d-flex justify-content-between';var a=document.createElement('span'),b=document.createElement('span');a.textContent=r[0];b.textContent=r[1];d.appendChild(a);d.appendChild(b);return d.outerHTML}).join('')+'<hr><div class="d-flex justify-content-between fw-bold"><span>Genel toplam</span><span>'+x.total+'</span></div>'}).catch(function(){box.textContent='Toplam hesaplanamadı.'})},250)}form.addEventListener('input',update);form.addEventListener('change',update);new MutationObserver(update).observe(document.getElementById('orderProducts'),{childList:true});update()})();
{/literal}
</script>
{/if}
